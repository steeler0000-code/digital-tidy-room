---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { siteConfig } from '@/config/site';

type RelatedItem = { href: string; title: string };
type Props = {
  entry: CollectionEntry<'articles'> | CollectionEntry<'columns'>;
  headings: { depth: number; slug: string; text: string }[];
  relatedItems?: RelatedItem[];
  kind: 'article' | 'column';
  categoryName?: string;
  categoryHref?: string;
};

const {
  entry,
  headings,
  relatedItems = [],
  kind,
  categoryName = '운영자 칼럼',
  categoryHref = '/columns/'
} = Astro.props;
const { data } = entry;
const published = data.publishedAt;
const updated = data.updatedAt;
const dateFormat = new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
const tocHeadings = headings.filter((heading) => heading.depth === 2);
const canonicalPath = kind === 'article' ? `/articles/${data.slug}/` : `/columns/${data.slug}/`;

const breadcrumbItems = [
  { label: '홈', href: '/' },
  { label: categoryName, href: categoryHref },
  { label: data.title }
];

const breadcrumbJson = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, Astro.site).toString() } : {})
  }))
};

const articleJson = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  inLanguage: 'ko-KR',
  mainEntityOfPage: new URL(canonicalPath, Astro.site).toString(),
  ...(published ? { datePublished: published.toISOString() } : {}),
  ...(updated ? { dateModified: updated.toISOString() } : published ? { dateModified: published.toISOString() } : {}),
  author: {
    '@type': 'Person',
    name: siteConfig.owner,
    url: new URL('/author/', Astro.site).toString()
  },
  publisher: {
    '@type': 'Organization',
    name: siteConfig.name,
    url: new URL('/', Astro.site).toString()
  }
};

const faqJson = data.faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: data.faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer }
      }))
    }
  : null;

const structuredData = [breadcrumbJson, articleJson, ...(faqJson ? [faqJson] : [])];
---

<BaseLayout
  title={data.title}
  description={data.description}
  canonicalPath={canonicalPath}
  ogType="article"
  structuredData={structuredData}
>
  <header class="article-header">
    <div class="container article-header__inner">
      <Breadcrumbs items={breadcrumbItems} />
      <p class="eyebrow">{kind === 'article' ? 'Practical Guide' : 'Editor Column'}</p>
      <h1>{data.title}</h1>
      <p class="article-header__subtitle">{data.subtitle}</p>
      <div class="article-meta">
        <span>글쓴이 <a href="/author/">{data.author}</a></span>
        {published && <span>발행 <time datetime={published.toISOString()}>{dateFormat.format(published)}</time></span>}
        {updated && <span>수정 <time datetime={updated.toISOString()}>{dateFormat.format(updated)}</time></span>}
        <span>출처 {data.sources.length}건 확인</span>
      </div>
    </div>
  </header>

  <div class="container section--compact article-shell">
    <article class="article-body">
      <div class="summary-box">
        <strong>먼저 읽는 핵심 요약</strong>
        <p>{data.summary}</p>
        <ul class="highlights">
          {data.highlights.map((highlight) => <li>{highlight}</li>)}
        </ul>
      </div>

      <div class="prose">
        <slot />
      </div>

      {data.faq.length > 0 && (
        <section class="article-section" aria-labelledby="faq-heading">
          <h2 id="faq-heading">자주 묻는 질문</h2>
          <div class="faq-list">
            {data.faq.map((item) => (
              <details>
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      <section class="article-section" aria-labelledby="sources-heading">
        <h2 id="sources-heading">확인한 자료</h2>
        <p>아래 공식 문서를 바탕으로 원칙과 기능을 확인했습니다. 서비스 화면과 세부 기능은 변경될 수 있습니다.</p>
        <ol class="source-list">
          {data.sources.map((source) => <li><a href={source.url} rel="noopener noreferrer">{source.title}</a></li>)}
        </ol>
      </section>

      {relatedItems.length > 0 && (
        <section class="article-section" aria-labelledby="related-heading">
          <h2 id="related-heading">함께 읽으면 좋은 글</h2>
          <div class="related-list">
            {relatedItems.map((item) => <a class="related-item" href={item.href}>{item.title}</a>)}
          </div>
        </section>
      )}

      <section class="article-section">
        <div class="author-panel">
          <div class="author-badge" aria-hidden="true">ㅋ</div>
          <div>
            <span class="eyebrow">Reviewed by</span>
            <h2><a href="/author/">{siteConfig.owner}</a></h2>
            <p>{siteConfig.ownerBio} 내용은 운영 과정에서 출처를 다시 확인하고 순차적으로 보완합니다.</p>
          </div>
          <a class="button button--secondary" href="/editorial-policy/">편집 원칙</a>
        </div>
      </section>
    </article>

    {tocHeadings.length > 0 && (
      <aside class="toc" aria-label="이 글의 목차">
        <strong>이 글의 목차</strong>
        <ul>
          {tocHeadings.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
        </ul>
      </aside>
    )}
  </div>
</BaseLayout>
