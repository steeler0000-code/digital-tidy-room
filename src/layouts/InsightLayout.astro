---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { siteConfig } from '@/config/site';

type Props = { entry: CollectionEntry<'guides'> | CollectionEntry<'briefings'>; headings: { depth:number; slug:string; text:string }[]; kind:'guide'|'briefing'; categoryName?:string; relatedItems?:{href:string;title:string}[] };
const { entry, headings, kind, categoryName='투자 방법론', relatedItems=[] } = Astro.props;
const { data } = entry; const isBriefing = kind === 'briefing';
const canonicalPath = isBriefing ? `/briefings/${data.slug}/` : `/guides/${data.slug}/`;
const basePath = isBriefing ? '/briefings/' : '/guides/';
const dateFormat = new Intl.DateTimeFormat('ko-KR',{year:'numeric',month:'long',day:'numeric'});
const breadcrumbItems=[{label:'홈',href:'/'},{label:isBriefing?'마켓 브리핑':categoryName,href:basePath},{label:data.title}];
const breadcrumbJson={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:breadcrumbItems.map((item,index)=>({'@type':'ListItem',position:index+1,name:item.label,...(item.href?{item:new URL(item.href,Astro.site).toString()}:{})}))};
const articleJson={'@context':'https://schema.org','@type':'Article',headline:data.title,description:data.description,inLanguage:'ko-KR',mainEntityOfPage:new URL(canonicalPath,Astro.site).toString(),datePublished:data.publishedAt?.toISOString(),dateModified:(data.updatedAt||('reviewedAt' in data?data.reviewedAt:data.publishedAt))?.toISOString(),author:{'@type':'Person',name:siteConfig.owner,url:new URL('/author/',Astro.site).toString()},publisher:{'@type':'Organization',name:siteConfig.name,url:new URL('/',Astro.site).toString()}};
const toc=headings.filter(h=>h.depth===2);
---
<BaseLayout title={data.title} description={data.description} canonicalPath={canonicalPath} ogType="article" structuredData={[breadcrumbJson,articleJson]}>
  <header class="article-header"><div class="container article-header__inner"><Breadcrumbs items={breadcrumbItems}/><p class="eyebrow">{isBriefing?'Market briefing':'Investment framework'}</p><h1>{data.title}</h1><p class="article-header__subtitle">{data.subtitle}</p><div class="article-meta"><span>글쓴이 <a href="/author/">{data.author}</a></span>{data.publishedAt&&<span>최초 발행 <time datetime={data.publishedAt.toISOString()}>{dateFormat.format(data.publishedAt)}</time></span>}{isBriefing&&'reviewedAt' in data&&<span>사이트 검토 <time datetime={data.reviewedAt.toISOString()}>{dateFormat.format(data.reviewedAt)}</time></span>}<span>출처 {data.sources.length}건</span></div></div></header>
  <div class="container article-shell section--compact"><article class="article-body">
    {isBriefing&&<div class="archive-notice"><strong>과거 마켓 브리핑</strong><p>이 글은 표시된 날짜 당시의 시장 정보입니다. 이후 상황이 달라졌을 수 있으므로 현재 시세나 매매 판단 자료로 그대로 사용하지 마세요.</p></div>}
    <div class="summary-box"><strong>먼저 읽는 핵심 요약</strong><p>{data.summary}</p><ul class="highlights">{data.highlights.map(item=><li>{item}</li>)}</ul></div>
    <div class="prose"><slot/></div>
    <section class="article-section" aria-labelledby="sources-heading"><h2 id="sources-heading">확인한 자료</h2><p>작성 당시 확인한 공개 자료입니다. 링크의 수치와 기준일을 함께 확인하세요.</p><ol class="source-list">{data.sources.map(source=><li><a href={source.url} rel="noopener noreferrer">{source.title}</a>{source.publisher&&<span> — {source.publisher}</span>}</li>)}</ol></section>
    {isBriefing&&'originalChannels' in data&&data.originalChannels.length>0&&<section class="article-section"><h2>최초 게시 채널</h2><div class="related-list">{data.originalChannels.map(channel=><a class="related-item" href={channel.url} rel="noopener noreferrer">{channel.name}</a>)}</div></section>}
    {relatedItems.length>0&&<section class="article-section"><h2>함께 읽으면 좋은 글</h2><div class="related-list">{relatedItems.map(item=><a class="related-item" href={item.href}>{item.title}</a>)}</div></section>}
    <div class="disclaimer-box"><strong>투자 정보 이용 안내</strong><p>이 글은 일반 정보 제공을 위한 자료이며 투자자문이나 특정 금융상품의 매수·매도 권유가 아닙니다. 투자 판단과 책임은 투자자 본인에게 있습니다.</p></div>
  </article>{toc.length>0&&<aside class="toc" aria-label="이 글의 목차"><strong>이 글의 목차</strong><ul>{toc.map(h=><li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></aside>}</div>
</BaseLayout>
