---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { getPublishedAnalyses } from '@/lib/content';
const analyses=await getPublishedAnalyses();
const labels={
  'foreign-flow':'외국인 수급',
  'intraday-gainers':'장중 급등 종목',
  'weekly-research':'주간 심층 분석'
};
---
<BaseLayout title="종목 분석" description="외국인 수급, 장중 급등 종목과 주간 심층 분석을 선정 기준·계산 방법·반대 시나리오와 함께 기록합니다.">
  <header class="page-hero"><div class="container"><p class="eyebrow">Evidence-led analysis</p><h1>종목 분석</h1><p class="page-hero__lead">순위만 옮기지 않고, 왜 선정했는지와 계산 방법, 반대 시나리오, 확인한 원자료를 함께 공개합니다.</p></div></header>
  <section class="section--compact"><div class="container"><label class="filter-box"><span>제목·종목·분석 유형 검색</span><input id="analysis-filter" type="search" placeholder="예: 외국인, 급등, 현금흐름" /></label><div class="article-grid filter-grid" id="analysis-grid">{analyses.map(entry=><div data-search={`${entry.data.title} ${entry.data.summary} ${labels[entry.data.analysisKind]}`}><ArticleCard href={`/analyses/${entry.data.slug}/`} title={entry.data.title} description={entry.data.description} label={labels[entry.data.analysisKind]} date={entry.data.analysisDate}/></div>)}</div>{analyses.length===0&&<p class="empty-state">검증을 마친 분석부터 순차적으로 공개합니다.</p>}<p class="empty-state" id="filter-empty" hidden>검색 조건에 맞는 분석이 없습니다.</p></div></section>
  <script is:inline>const input=document.querySelector('#analysis-filter');const cards=[...document.querySelectorAll('#analysis-grid>[data-search]')];const empty=document.querySelector('#filter-empty');input?.addEventListener('input',()=>{const q=input.value.trim().toLowerCase();let shown=0;cards.forEach(card=>{const yes=card.dataset.search.toLowerCase().includes(q);card.hidden=!yes;if(yes)shown++});empty.hidden=shown!==0;});</script>
</BaseLayout>
