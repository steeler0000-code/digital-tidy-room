---
import { getCollection, render } from 'astro:content';
import InsightLayout from '@/layouts/InsightLayout.astro';
import { isPublished } from '@/lib/content';import { getGuideCategory } from '@/data/categories';
export async function getStaticPaths(){const entries=(await getCollection('guides')).filter(isPublished);return entries.map(entry=>({params:{slug:entry.data.slug},props:{entry,all:entries}}));}
const {entry,all}=Astro.props;const {Content,headings}=await render(entry);const related=all.filter((x:any)=>x.data.category===entry.data.category&&x.data.slug!==entry.data.slug).slice(0,3).map((x:any)=>({href:`/guides/${x.data.slug}/`,title:x.data.title}));
---
<InsightLayout entry={entry} headings={headings} kind="guide" categoryName={getGuideCategory(entry.data.category)?.name} relatedItems={related}><Content/></InsightLayout>
