---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="페이지를 찾을 수 없습니다" description="요청한 페이지가 이동했거나 존재하지 않습니다." noindex>
  <section class="not-found">
    <div class="container">
      <span class="not-found__code">404</span>
      <p class="eyebrow">Room Not Found</p>
      <h1>찾던 페이지가 이곳에는 없습니다</h1>
      <p>주소를 다시 확인하거나 주제별 안내에서 필요한 글을 찾아보세요.</p>
      <div class="hero__actions" style="justify-content:center">
        <a class="button" href="/">홈으로 이동</a>
        <a class="button button--secondary" href="/categories/">주제별 안내</a>
      </div>
    </div>
  </section>
</BaseLayout>
