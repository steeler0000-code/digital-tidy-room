---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { categories, type Category } from '@/data/categories';
import { getPublishedArticles } from '@/lib/content';

export const getStaticPaths = (async () => categories.map((category) => ({ params: { slug: category.slug }, props: { category } }))) satisfies GetStaticPaths;

const { category } = Astro.props as { category: Category };
const articles = (await getPublishedArticles()).filter((article) => article.data.category === category.slug);
const breadcrumbs = [
  { label: '홈', href: '/' },
  { label: '주제별 안내', href: '/categories/' },
  { label: category.name }
];
const breadcrumbJson = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, Astro.site).toString() } : {})
  }))
};
---

<BaseLayout title={category.name} description={category.description} canonicalPath={`/categories/${category.slug}/`} structuredData={breadcrumbJson}>
  <header class="page-hero">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />
      <div class="category-intro">
        <div class="category-intro__number" style={`background:${category.accent}`}>{category.number}</div>
        <div>
          <p class="eyebrow">Topic Room</p>
          <h1>{category.name}</h1>
          <p class="page-hero__lead">{category.description}</p>
        </div>
      </div>
    </div>
  </header>
  <section class="section--compact">
    <div class="container">
      {articles.length ? (
        <div class="article-grid">
          {articles.map((article) => (
            <ArticleCard
              href={`/articles/${article.data.slug}/`}
              title={article.data.title}
              description={article.data.description}
              label={category.name}
              date={article.data.updatedAt || article.data.publishedAt}
            />
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <h2>검토 중인 글이 있습니다</h2>
          <p>출처와 실행 순서를 확인한 뒤 공개합니다. 다른 주제의 안내를 먼저 살펴보세요.</p>
          <a class="button button--secondary" href="/categories/">다른 주제 보기</a>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
