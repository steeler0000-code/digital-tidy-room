---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import AuthorPanel from '@/components/AuthorPanel.astro';
import { categories, getCategory } from '@/data/categories';
import { siteConfig } from '@/config/site';
import { getPublishedArticles, getPublishedColumns } from '@/lib/content';

const articles = await getPublishedArticles();
const columns = await getPublishedColumns();
const featured = articles.filter((article) => article.data.featured).slice(0, 3);
const latest = articles.filter((article) => !featured.some((item) => item.data.slug === article.data.slug)).slice(0, 3);
const latestFallback = latest.length ? latest : articles.slice(0, 3);

const websiteJson = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  url: new URL('/', Astro.site).toString(),
  description: siteConfig.description,
  inLanguage: 'ko-KR',
  publisher: {
    '@type': 'Organization',
    name: siteConfig.name,
    url: new URL('/', Astro.site).toString()
  }
};
---

<BaseLayout structuredData={websiteJson}>
  <section class="hero">
    <div class="container hero__grid">
      <div>
        <p class="eyebrow">Digital Life Guide</p>
        <h1>찾느라 헤매지 않고,<br /><span>잃을까 걱정하지 않게.</span></h1>
        <p class="hero__lead">
          파일·사진·이메일·계정을 한 번에 완벽하게 정리하려 하지 않습니다. 오늘 바로 적용할 수 있는 작은 기준부터 설명합니다.
        </p>
        <div class="hero__actions">
          <a class="button" href="/categories/">주제별 안내 보기</a>
          <a class="button button--secondary" href="/about/">운영 목적 알아보기</a>
        </div>
      </div>
      <aside class="hero__note" aria-label="디지털 정리의 세 가지 기준">
        <span class="note-label">정리의 기본</span>
        <ol>
          <li><span>1</span> 지금 사용하는 것과 보관할 것을 나눕니다.</li>
          <li><span>2</span> 다시 찾을 수 있는 이름과 위치를 정합니다.</li>
          <li><span>3</span> 잃어도 복구할 수 있는 사본을 확인합니다.</li>
        </ol>
      </aside>
    </div>
  </section>

  <section class="section--compact">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Five Rooms</p>
          <h2>생활 속 디지털 자료를<br />다섯 공간으로 나눴습니다</h2>
        </div>
        <a class="text-link" href="/categories/">카테고리 전체 보기</a>
      </div>
      <div class="category-grid">
        {categories.map((category) => (
          <a class="category-card" href={`/categories/${category.slug}/`} style={`background:${category.accent}`}>
            <span class="category-card__number">ROOM {category.number}</span>
            <h3>{category.name}</h3>
            <p>{category.shortDescription}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Start Here</p>
            <h2>처음이라면 이 글부터</h2>
            <p>도구보다 기준을 먼저 이해할 수 있는 대표 안내를 골랐습니다.</p>
          </div>
        </div>
        <div class="article-grid">
          {featured.map((article) => (
            <ArticleCard
              href={`/articles/${article.data.slug}/`}
              title={article.data.title}
              description={article.data.description}
              label={getCategory(article.data.category)?.name || '정보글'}
              date={article.data.updatedAt || article.data.publishedAt}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section principles">
    <div class="container principles-grid">
      <div>
        <p class="eyebrow">Editorial Standard</p>
        <h2>무엇을 쓰는지만큼<br />어떻게 확인했는지를 밝힙니다</h2>
        <p>과장된 효율이나 만능 도구를 약속하지 않습니다. 독자가 직접 적용하고 판단할 수 있는 순서와 주의점을 함께 제공합니다.</p>
        <a class="button" href="/editorial-policy/">편집 원칙 자세히 보기</a>
      </div>
      <div class="principles-list">
        <div class="principle">
          <h3>공식 자료 우선</h3>
          <p>기능과 보안 원칙은 운영체제·서비스 제공자·공공기관의 문서를 먼저 확인합니다.</p>
        </div>
        <div class="principle">
          <h3>실행 가능한 설명</h3>
          <p>추상적인 조언보다 선택 기준, 순서, 되돌리는 방법과 체크리스트를 제공합니다.</p>
        </div>
        <div class="principle">
          <h3>정직한 수정 기록</h3>
          <p>내용을 실제로 검토하거나 바꾼 경우에만 수정일을 갱신합니다.</p>
        </div>
      </div>
    </div>
  </section>

  {latestFallback.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Recently Published</p>
            <h2>최근 공개한 안내</h2>
          </div>
          <a class="text-link" href="/categories/">모든 글 보기</a>
        </div>
        <div class="article-grid">
          {latestFallback.map((article) => (
            <ArticleCard
              href={`/articles/${article.data.slug}/`}
              title={article.data.title}
              description={article.data.description}
              label={getCategory(article.data.category)?.name || '정보글'}
              date={article.data.updatedAt || article.data.publishedAt}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  {columns.length > 0 && (
    <section class="section--compact">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Kailus Column</p>
            <h2>정리 기준을 생각하는 짧은 칼럼</h2>
          </div>
          <a class="text-link" href="/columns/">칼럼 전체 보기</a>
        </div>
        <div class="article-grid">
          {columns.slice(0, 3).map((column) => (
            <ArticleCard
              href={`/columns/${column.data.slug}/`}
              title={column.data.title}
              description={column.data.description}
              label="카일루스"
              date={column.data.updatedAt || column.data.publishedAt}
              kind="칼럼"
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <AuthorPanel />
    </div>
  </section>

  <section class="section--compact">
    <div class="container">
      <div class="cta-panel">
        <div class="author-badge" aria-hidden="true">@</div>
        <div>
          <p class="eyebrow">Contact</p>
          <h2>내용 오류나 더 알고 싶은 점이 있나요?</h2>
          <p>수정이 필요한 내용과 궁금한 주제를 이메일로 알려주세요.</p>
        </div>
        <a class="button" href="/contact/">문의 방법 보기</a>
      </div>
    </div>
  </section>
</BaseLayout>
