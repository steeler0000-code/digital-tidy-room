---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { getPublishedBriefings, getPublishedGuides } from '@/lib/content';
import { getGuideCategory } from '@/data/categories';
const briefings=await getPublishedBriefings();const guides=await getPublishedGuides();
---

<BaseLayout>
  <section class="hero market-hero">
    <div class="container hero__grid">
      <div>
        <p class="eyebrow">Market context, not market noise</p>
        <h1>시장의 숫자를,<br /><span>판단의 언어로.</span></h1>
        <p class="hero__lead">Caelus는 국내·미국 시장의 핵심 이슈를 추려 왜 움직였는지, 어떤 지표를 다음에 확인해야 하는지 설명합니다.</p>
        <div class="hero__actions">
          <a class="button" href="/briefings/">마켓 브리핑 보기</a>
          <a class="button button--secondary" href="/tools/">투자 도구 사용하기</a>
        </div>
      </div>
      <aside class="hero__note market-note" aria-label="Caelus의 해석 순서">
        <span class="note-label">CAELUS FRAMEWORK</span>
        <ol>
          <li><span>1</span><div><strong>사실</strong><br />시점과 출처를 확인합니다.</div></li>
          <li><span>2</span><div><strong>전달 경로</strong><br />금리·환율·실적의 연결을 봅니다.</div></li>
          <li><span>3</span><div><strong>확인 지표</strong><br />전망을 검증할 다음 숫자를 남깁니다.</div></li>
        </ol>
      </aside>
    </div>
  </section>

  <section class="section--compact">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">What you get</p><h2>뉴스 요약을 넘어서</h2><p>날짜별 브리핑, 오래 쓰는 투자 방법론, 입력값으로 직접 확인하는 계산기를 한곳에 모습니다.</p></div></div>
      <div class="article-grid">
        <a class="article-card" href="/briefings/"><div class="article-card__meta"><span class="article-card__kind">날짜별 기록</span></div><h3>마켓 브리핑</h3><p>오늘의 이슈를 사실, 해석, 상·하방 요인으로 나누어 읽습니다.</p><span class="article-card__more">아카이브 보기 →</span></a>
        <a class="article-card" href="/guides/"><div class="article-card__meta"><span class="article-card__kind">판단의 기준</span></div><h3>투자 방법론</h3><p>AI 실적, 환헤지, ETF 구조를 최근 시장 사례로 풀어냅니다.</p><span class="article-card__more">가이드 보기 →</span></a>
        <a class="article-card" href="/tools/"><div class="article-card__meta"><span class="article-card__kind">브라우저 계산</span></div><h3>투자 도구</h3><p>복리, 환율 포함 수익률, 자산배분 차이를 직접 계산합니다.</p><span class="article-card__more">계산기 보기 →</span></a>
      </div>
    </div>
  </section>

  <section class="section--compact"><div class="container"><div class="section-heading"><div><p class="eyebrow">Latest briefing</p><h2>최근 마켓 브리핑</h2><p>가장 최근 날짜부터 당시 시장을 움직인 변수와 다음 확인 지표를 읽어보세요.</p></div><a class="text-link" href="/briefings/">전체 아카이브</a></div><div class="article-grid">{briefings.slice(0,3).map(entry=><ArticleCard href={`/briefings/${entry.data.slug}/`} title={entry.data.title} description={entry.data.description} label={entry.data.markets.join(' · ')} date={entry.data.briefingDate}/>)}</div></div></section>

  <section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">Start with a framework</p><h2>요즘 시장을 읽는 12가지 기준</h2><p>금리·환율·AI 실적과 복잡 ETF를 최근 사례에서 출발해 오래 쓰는 판단법으로 정리했습니다.</p></div><a class="text-link" href="/guides/">방법론 전체 보기</a></div><div class="article-grid">{guides.filter(g=>g.data.featured).slice(0,3).map(entry=><ArticleCard href={`/guides/${entry.data.slug}/`} title={entry.data.title} description={entry.data.description} label={getGuideCategory(entry.data.category)?.name||'투자 가이드'} date={entry.data.publishedAt}/>)}</div></div></section>

  <section class="principles section">
    <div class="container principles-grid">
      <div><p class="eyebrow">Editorial standard</p><h2>예측보다<br />검증 가능한 기준</h2><p>특정 종목을 권하지 않습니다. 숫자의 기준 시점과 출처, 전망이 틀릴 조건을 함께 기록합니다.</p></div>
      <div class="principles-list">
        <div class="principle"><h3>공식 자료 우선</h3><p>중앙은행, 거래소, 공시, 기업 발표 원문을 우선합니다.</p></div>
        <div class="principle"><h3>사실과 해석 분리</h3><p>확인된 숫자와 운영자의 해석이 섞이지 않게 표시합니다.</p></div>
        <div class="principle"><h3>매매 신호 금지</h3><p>정보는 판단의 재료이며, 최종 투자 책임은 투자자에게 있습니다.</p></div>
      </div>
    </div>
  </section>
</BaseLayout>
