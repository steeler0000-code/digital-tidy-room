---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { getCategory } from '@/data/categories';
import { isPublished } from '@/lib/content';

export const getStaticPaths = (async () => {
  const articles = (await getCollection('articles')).filter(isPublished);
  return articles.map((article) => ({ params: { slug: article.data.slug }, props: { article, articles } }));
}) satisfies GetStaticPaths;

type ArticleEntry = CollectionEntry<'articles'>;
const { article, articles } = Astro.props as {
  article: ArticleEntry;
  articles: ArticleEntry[];
};
const { Content, headings } = await render(article);
const category = getCategory(article.data.category);
const relatedItems = article.data.related
  .map((slug) => articles.find((item) => item.data.slug === slug))
  .filter((item): item is ArticleEntry => Boolean(item))
  .map((item) => ({ href: `/articles/${item.data.slug}/`, title: item.data.title }));
---

<ArticleLayout
  entry={article}
  headings={headings}
  relatedItems={relatedItems}
  kind="article"
  categoryName={category?.name}
  categoryHref={`/categories/${category?.slug}/`}
>
  <Content />
</ArticleLayout>
