---
import BaseLayout from '@/layouts/BaseLayout.astro';import {tools} from '@/data/tools';import {getPublishedBriefings,getPublishedGuides} from '@/lib/content';
const briefings=await getPublishedBriefings();const guides=await getPublishedGuides();const primary=[['홈','/'],['마켓 브리핑','/briefings/'],['투자 방법론','/guides/'],['투자 도구','/tools/'],['사이트 소개','/about/'],['운영자','/author/'],['문의','/contact/']];const policies=[['편집 원칙','/editorial-policy/'],['개인정보처리방침','/privacy/'],['이용약관','/terms/'],['면책고지','/disclaimer/']];
---
<BaseLayout title="전체 사이트맵" description="Caelus의 공개 브리핑, 투자 가이드, 계산 도구와 정책 페이지를 확인하세요."><header class="page-hero"><div class="container"><p class="eyebrow">HTML sitemap</p><h1>전체 사이트맵</h1><p class="page-hero__lead">현재 공개된 모든 페이지입니다.</p></div></header><section class="section--compact"><div class="container sitemap-grid"><section class="sitemap-group"><h2>주요 페이지</h2><ul>{primary.map(([l,h])=><li><a href={h}>{l}</a></li>)}</ul></section><section class="sitemap-group"><h2>투자 도구</h2><ul>{tools.map(t=><li><a href={`/tools/${t.slug}/`}>{t.title}</a></li>)}</ul></section><section class="sitemap-group"><h2>정책과 원칙</h2><ul>{policies.map(([l,h])=><li><a href={h}>{l}</a></li>)}</ul></section><section class="sitemap-group"><h2>투자 방법론</h2><ul>{guides.map(g=><li><a href={`/guides/${g.data.slug}/`}>{g.data.title}</a></li>)}</ul></section><section class="sitemap-group"><h2>마켓 브리핑</h2><ul>{briefings.map(b=><li><a href={`/briefings/${b.data.slug}/`}>{b.data.title}</a></li>)}</ul></section></div></section></BaseLayout>
