---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { categories, getCategory } from '@/data/categories';
import { getPublishedArticles, getPublishedColumns } from '@/lib/content';
const articles = await getPublishedArticles();
const columns = await getPublishedColumns();
const primary = [
  ['홈', '/'], ['주제별 안내', '/categories/'], ['칼럼', '/columns/'], ['사이트 소개', '/about/'], ['운영자 소개', '/author/'], ['문의하기', '/contact/']
];
const policies = [
  ['편집 원칙', '/editorial-policy/'], ['개인정보처리방침', '/privacy/'], ['이용약관', '/terms/'], ['면책고지', '/disclaimer/']
];
---

<BaseLayout title="전체 사이트맵" description="디지털 정리실의 주제, 정보글, 칼럼과 정책 문서를 한눈에 확인하세요.">
  <header class="page-hero"><div class="container"><p class="eyebrow">HTML Sitemap</p><h1>전체 사이트맵</h1><p class="page-hero__lead">현재 공개되어 검색할 수 있는 모든 페이지입니다.</p></div></header>
  <section class="section--compact">
    <div class="container sitemap-grid">
      <section class="sitemap-group"><h2>주요 페이지</h2><ul>{primary.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul></section>
      <section class="sitemap-group"><h2>주제</h2><ul>{categories.map((category) => <li><a href={`/categories/${category.slug}/`}>{category.name}</a></li>)}</ul></section>
      <section class="sitemap-group"><h2>정책과 원칙</h2><ul>{policies.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul></section>
      <section class="sitemap-group"><h2>정보글</h2><ul>{articles.map((article) => <li><a href={`/articles/${article.data.slug}/`}>{article.data.title}</a> <small>({getCategory(article.data.category)?.name})</small></li>)}</ul></section>
      <section class="sitemap-group"><h2>운영자 칼럼</h2><ul>{columns.map((column) => <li><a href={`/columns/${column.data.slug}/`}>{column.data.title}</a></li>)}</ul></section>
    </div>
  </section>
</BaseLayout>
