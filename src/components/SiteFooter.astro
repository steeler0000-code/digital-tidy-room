---
import { siteConfig } from '@/config/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div>
        <a class="brand site-footer__brand" href="/">
          <img class="brand__symbol" src="/favicon.png" width="44" height="44" alt="" />
          <span class="brand__name">CAELUS</span>
        </a>
        <p class="site-footer__description">{siteConfig.tagline}</p>
        <p>
          운영자 <a href="/author/">{siteConfig.owner}</a><br />
          <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
        </p>
      </div>
      <nav class="footer-links" aria-label="사이트 안내">
        <strong>사이트 안내</strong>
        <a href="/briefings/">마켓 브리핑</a>
        <a href="/guides/">투자 방법론</a>
        <a href="/tools/">투자 도구</a>
        <a href="/about/">사이트 소개</a>
        <a href="/author/">운영자 소개</a>
        <a href="/editorial-policy/">편집 원칙</a>
        <a href="/contact/">문의하기</a>
        <a href="/sitemap/">전체 사이트맵</a>
      </nav>
      <nav class="footer-links" aria-label="정책 안내">
        <strong>정책 안내</strong>
        <a href="/privacy/">개인정보처리방침</a>
        <a href="/terms/">이용약관</a>
        <a href="/disclaimer/">면책고지</a>
      </nav>
    </div>
    <div class="site-footer__bottom">
      <span>© {year} {siteConfig.name}. All rights reserved.</span>
      <span>투자 판단과 책임은 투자자 본인에게 있습니다.</span>
    </div>
  </div>
</footer>
