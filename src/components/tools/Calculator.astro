---
import type { ToolDefinition } from '@/data/tools';
const {tool}=Astro.props as {tool:ToolDefinition};
---
<div class="calculator" data-calculator={tool.slug}>
 {tool.slug==='compound'&&<form class="calculator-form"><label>초기 투자금(원)<input name="initial" type="number" min="0" value="10000000" required/></label><label>월 적립액(원)<input name="monthly" type="number" min="0" value="500000" required/></label><label>연 기대수익률(%)<input name="rate" type="number" min="-99" max="1000" step="0.1" value="6" required/></label><label>기간(년)<input name="years" type="number" min="1" max="60" value="10" required/></label><button class="button" type="submit">계산하기</button><button class="button button--secondary" type="reset">초기화</button></form>}
 {tool.slug==='return'&&<form class="calculator-form"><label>매수가<input name="buy" type="number" min="0.0001" step="any" value="100" required/></label><label>매도가<input name="sell" type="number" min="0.0001" step="any" value="120" required/></label><label>수량<input name="quantity" type="number" min="0.0001" step="any" value="10" required/></label><label>매수 환율<input name="buyFx" type="number" min="0.0001" step="any" value="1300" required/></label><label>매도 환율<input name="sellFx" type="number" min="0.0001" step="any" value="1350" required/></label><label>총 비용(원)<input name="fees" type="number" min="0" step="any" value="0" required/></label><button class="button" type="submit">계산하기</button><button class="button button--secondary" type="reset">초기화</button></form>}
 {tool.slug==='allocation'&&<form class="calculator-form allocation-form"><div class="allocation-head"><span>자산</span><span>현재 금액</span><span>목표 비중(%)</span></div>{['주식','채권','현금'].map((name,i)=><div class="allocation-row"><input name="name" value={name} aria-label={`자산 ${i+1} 이름`}/><input name="amount" type="number" min="0" value={[6000000,3000000,1000000][i]} aria-label={`${name} 현재 금액`} required/><input name="target" type="number" min="0" max="100" value={[50,30,20][i]} aria-label={`${name} 목표 비중`} required/></div>)}<button class="button" type="submit">차이 계산하기</button><button class="button button--secondary" type="reset">초기화</button></form>}
 <div class="calculator-result" aria-live="polite"><p>값을 입력하고 계산하면 여기에 결과가 표시됩니다.</p></div>
 <p class="calculator-note">입력값은 이 브라우저 안에서만 계산되며 저장하거나 전송하지 않습니다. 세금과 개인별 거래 조건은 반영하지 않습니다.</p>
</div>
<script>
 import {compoundScenario,investmentReturn,allocationGap} from '@/lib/calculators';
 const money=(v:number)=>new Intl.NumberFormat('ko-KR',{maximumFractionDigits:0}).format(v)+'원';
 document.querySelectorAll<HTMLElement>('[data-calculator]').forEach(root=>{const form=root.querySelector('form')!;const result=root.querySelector<HTMLElement>('.calculator-result')!;form.addEventListener('submit',e=>{e.preventDefault();const fd=new FormData(form);const n=(k:string)=>Number(fd.get(k));try{if(root.dataset.calculator==='compound'){const x=compoundScenario(n('initial'),n('monthly'),n('rate'),n('years'));result.innerHTML=`<h2>계산 결과</h2><dl><div><dt>총 납입액</dt><dd>${money(x.contributed)}</dd></div><div><dt>예상 평가액</dt><dd>${money(x.value)}</dd></div><div><dt>예상 손익</dt><dd>${money(x.gain)}</dd></div></dl>`;}else if(root.dataset.calculator==='return'){const x=investmentReturn(n('buy'),n('sell'),n('quantity'),n('buyFx'),n('sellFx'),n('fees'));result.innerHTML=`<h2>계산 결과</h2><dl><div><dt>투입 금액</dt><dd>${money(x.invested)}</dd></div><div><dt>최종 금액</dt><dd>${money(x.net)}</dd></div><div><dt>총 수익률</dt><dd>${x.rate.toFixed(2)}%</dd></div><div><dt>가격 변화</dt><dd>${x.priceOnly.toFixed(2)}%</dd></div><div><dt>환율 변화</dt><dd>${x.fxOnly.toFixed(2)}%</dd></div></dl>`;}else{const names=[...form.querySelectorAll<HTMLInputElement>('[name=name]')].map(x=>x.value);const amounts=[...form.querySelectorAll<HTMLInputElement>('[name=amount]')].map(x=>Number(x.value));const targets=[...form.querySelectorAll<HTMLInputElement>('[name=target]')].map(x=>Number(x.value));if(Math.abs(targets.reduce((a,b)=>a+b,0)-100)>.01)throw new Error('목표 비중의 합을 100%로 맞춰주세요.');const x=allocationGap(names.map((name,i)=>({name,amount:amounts[i],target:targets[i]})));result.innerHTML=`<h2>총 자산 ${money(x.total)}</h2><div class="allocation-results">${x.rows.map(row=>`<p><strong>${row.name}</strong> 현재 ${row.current.toFixed(1)}% → 목표 ${row.target}% · ${row.difference>=0?'추가':'축소'} ${money(Math.abs(row.difference))}</p>`).join('')}</div>`;}}catch(err){result.innerHTML=`<p class="form-error">${err instanceof Error?err.message:'입력값을 확인해주세요.'}</p>`;}});form.addEventListener('reset',()=>setTimeout(()=>result.innerHTML='<p>값을 입력하고 계산하면 여기에 결과가 표시됩니다.</p>',0));});
</script>
