---
import { siteConfig } from '@/config/site';
import { getPublishedAnalyses } from '@/lib/content';

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
const hasAnalyses=(await getPublishedAnalyses()).length>0;
const navItems=hasAnalyses
  ? [...siteConfig.navigation.slice(0,3),{label:'종목 분석',href:'/analyses/'},...siteConfig.navigation.slice(3)]
  : siteConfig.navigation;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label={`${siteConfig.name} 홈`}>
      <img class="brand__symbol" src="/favicon.png" width="44" height="44" alt="" />
      <span class="brand__name">CAELUS</span>
    </a>

    <nav class="desktop-nav" aria-label="주요 메뉴">
      {
        navItems.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <details class="mobile-nav">
      <summary>메뉴</summary>
      <nav class="mobile-nav__panel" aria-label="모바일 주요 메뉴">
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </details>
  </div>
</header>
