#!/usr/bin/env python3
"""Constrained diagnostics for the isolated Caelus site checkout."""

from __future__ import annotations

from datetime import datetime
from pathlib import Path
import re
import subprocess
import sys


REPO = Path(__file__).resolve().parents[1] / "repos" / "caelus-site"


def run(*command: str) -> int:
    return subprocess.run(command, cwd=REPO, check=False).returncode


def clean() -> bool:
    result = subprocess.run(
        ["git", "status", "--porcelain", "--untracked-files=no"],
        cwd=REPO, check=False, text=True, capture_output=True,
    )
    return result.returncode == 0 and not result.stdout.strip()


def main() -> int:
    if not REPO.is_dir():
        print("격리된 Caelus checkout이 없습니다.", file=sys.stderr)
        return 2
    if len(sys.argv) < 2:
        print("사용법: caelus-engineer status|diff|test|build|verify|prepare <slug>", file=sys.stderr)
        return 2

    action = sys.argv[1]
    if action == "status" and len(sys.argv) == 2:
        return run("git", "status", "--short", "--branch")
    if action == "diff" and len(sys.argv) == 2:
        checked = run("git", "diff", "--check")
        return checked or run("git", "diff", "--stat")
    if action == "test" and len(sys.argv) == 2:
        return run("npm", "test")
    if action == "build" and len(sys.argv) == 2:
        return run("npm", "run", "build")
    if action == "verify" and len(sys.argv) == 2:
        checked = run("git", "diff", "--check")
        return checked or run("npm", "run", "build")
    if action == "prepare" and len(sys.argv) == 3:
        slug = sys.argv[2]
        if not re.fullmatch(r"[a-z0-9][a-z0-9-]{1,48}", slug):
            print("작업명은 영문 소문자, 숫자, 하이픈만 사용할 수 있습니다.", file=sys.stderr)
            return 2
        if not clean():
            print("추적 파일 변경이 있어 새 작업을 준비하지 않습니다.", file=sys.stderr)
            return 3
        if run("git", "fetch", "origin", "main"):
            return 4
        branch = f"agent/caelus-engineer/{datetime.now().strftime('%Y%m%d')}-{slug}"
        return run("git", "switch", "-C", branch, "origin/main")

    print("허용되지 않은 명령입니다.", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
